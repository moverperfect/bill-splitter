{
  "name": "bill-splitter",
  "private": true,
  "version": "1.0.0",
  "description": "Mobile-first, offline bill splitter for group trips: split item by item in any currency.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "biome check .",
    "fmt": "biome check --write ."
  },
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.144.0"
  }
}
